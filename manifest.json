{
  "manifest_version": 3,
  "name": "ChatGPT 侧边栏",
  "version": "0.3.2",
  "description": "默认在 Edge 侧栏内使用 ChatGPT，支持选区发送和仅填入；顶部设置可开关功能，高级选项提供稳定标签页投递。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "打开 / 关闭 ChatGPT 侧边栏",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "contextMenus",
    "tabs",
    "browsingData"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://*.openai.com/*",
    "<all_urls>"
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开 / 关闭 ChatGPT 侧边栏"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://*.openai.com/*"
      ],
      "js": [
        "content/chatgpt-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://*.openai.com/*"
      ],
      "js": [
        "content/selection.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "headers",
        "enabled": false,
        "path": "rules/headers.json"
      },
      {
        "id": "site",
        "enabled": false,
        "path": "rules/site.json"
      }
    ]
  }
}
